{
  "name": "hippocampus-garden",
  "private": true,
  "description": "Repository entrypoint for the Astro-based Hippocampus's Garden site",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.15.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"package.json\" \".prettierrc\" \"eslint.config.mjs\" \"astro.config.mjs\" \"public/**/*.js\" \"src/**/*.{astro,ts,js,css}\" \".github/workflows/*.{yml,yaml}\" \".vscode/*.json\" \"README.md\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"package.json\" \".prettierrc\" \"eslint.config.mjs\" \"astro.config.mjs\" \"public/**/*.js\" \"src/**/*.{astro,ts,js,css}\" \".github/workflows/*.{yml,yaml}\" \".vscode/*.json\" \"README.md\" \"docs/**/*.md\"",
    "prepare": "husky",
    "start": "npm run dev"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,css,json,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.0",
    "@astrojs/rss": "^4.0.19",
    "astro": "^7.1.3",
    "dotenv": "^16.6.1",
    "googleapis": "^172.0.0",
    "mermaid": "^11.16.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.5.2",
    "eslint": "^10.2.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1"
  }
}
